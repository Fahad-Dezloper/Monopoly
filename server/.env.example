# Copy to .env for local dev. On Render, render.yaml sets everything except
# CORS_ORIGIN, which it prompts for.

# Render injects PORT itself — do not set it there.
PORT=4000

# Comma-separated list of allowed browser origins. Only matters when the front
# end calls the API directly; the Vercel deploy proxies through /api/* instead,
# which is same-origin.
CORS_ORIGIN=http://localhost:3000

# "redis" or "memory". Memory keeps everything in a process-local Map, which is
# fine for a single dev instance and loses all state on restart.
REDIS_MODE=memory
REDIS_URL=redis://localhost:6379

# Optional. Postgres only stores guest profile rows; leave it unset and they
# live in Redis instead. Nothing else in the app touches it.
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/robinverse?schema=public"
