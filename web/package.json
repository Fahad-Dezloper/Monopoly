{
  "name": "robinverse-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "gen:board": "node scripts/gen-board-svg.mjs",
    "sync:idl": "cp ../onchain/idl/robinverse.json src/lib/chain/robinverse.json",
    "verify:chain": "node scripts/verify-instructions.mjs && node scripts/verify-account-shape.mjs",
    "format": "prettier --write ../web/src ../web/scripts ../server/src ../onchain/scripts",
    "format:check": "prettier --check ../web/src ../web/scripts ../server/src ../onchain/scripts",
    "test:ui": "node scripts/ui-states.mjs",
    "test:chain-ui": "node scripts/ui-chain.mjs",
    "test:live": "node scripts/ui-game-live.mjs"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@magicblock-labs/ephemeral-rollups-sdk": "0.16.2",
    "@number-flow/react": "^0.6.2",
    "@solana/web3.js": "1.98.4",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prettier": "^3.9.6",
    "puppeteer-core": "^25.5.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
