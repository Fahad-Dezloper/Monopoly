# Copy to .env.local for local dev. On Vercel these go in
# Settings -> Environment Variables. Every NEXT_PUBLIC_* value is inlined into
# the client bundle at build time, so changing one needs a redeploy, and none of
# them may hold a secret.

# 1 = play on Solana + MagicBlock. 0 = play against the NestJS server instead.
NEXT_PUBLIC_CHAIN=1

NEXT_PUBLIC_PROGRAM_ID=AyHcc7ySuwU5qfinS94CPaZKpiWCXWfFdxLtww8bupAs
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
NEXT_PUBLIC_MAGIC_ROUTER=https://devnet-router.magicblock.app/

# Pins new games to one ephemeral rollup. Validators clone the program on first
# use and keep that copy, so after any program upgrade run
# `node onchain/scripts/check-er-freshness.mjs`; once every validator reports
# current, drop this and let the router pick the nearest one.
NEXT_PUBLIC_ER_VALIDATOR=MAS1Dt9qreoRMQ14YQuhg8UTZMMzDdKhmkZMECCzk57

# Where /api/* is proxied. Build-time only — it is compiled into the rewrite
# rules, not read at runtime. Set this to the Render URL on Vercel, no trailing
# slash and no /api suffix.
# API_PROXY_TARGET=https://robinverse-server.onrender.com

# Optional escape hatch: call the API directly from the browser instead of
# through the proxy above. Needs CORS_ORIGIN on the server to list this site.
# NEXT_PUBLIC_API_URL=https://robinverse-server.onrender.com/api

# Used for canonical/OG URLs only.
# NEXT_PUBLIC_SITE_URL=https://robin-empire.vercel.app
